# =====================================================
# BEYOND — Sovereign AI Operating System v2.0
# Environment Configuration (Production Ready)
# =====================================================

# ============ SERVER CONFIG ============
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com

# ============ AUTHENTICATION ============
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
AUTH_TOKEN_EXPIRY=24h
SALT_ROUNDS=12

# ============ OWNER BOOTSTRAP ============
# First account created on startup — change immediately after first login
OWNER_EMAIL=admin@yourdomain.com
OWNER_PASSWORD=ChangeMeNow123!

# ============ DATABASE ============
DB_TYPE=sqlite
DB_PATH=./data/primordex.db

# ============ GROQ AI — PRIMARY AI PROVIDER ============
# Get free key: https://groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_DEEP=openai/gpt-oss-120b

# Optional: Anthropic fallback
ANTHROPIC_API_KEY=

# Optional: OpenAI fallback
OPENAI_API_KEY=

# ============ VECTOR STORE (ChromaDB) — RAG ============
CHROMA_DB_PATH=./chromadb_data
EMBEDDING_MODEL=text-embedding-004

# ============ REDIS (Optional — for distributed sessions/rate limiting) ============
# Set REDIS_HOST to enable Redis; otherwise memory fallback is used
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ============ PAYMENT GATEWAYS ============
# Paystack (NGN)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Stripe (International)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Coinbase Commerce (Crypto)
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# ============ SCHEDULER ============
BRIEFING_TIME=07:00
ALERT_INTERVAL=900000
LEGAL_SCAN_DAY=1
LEGAL_SCAN_TIME=08:00

# ============ MISC ============
MAX_UPLOAD_SIZE=52428800
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60
CONSCIOUSNESS_STATE=ACTIVE

# ============ LIVE DATA ============
# Web search is enabled by default (DuckDuckGo HTML, no API key needed)
ENABLE_WEB_SEARCH=true
ENABLE_RSS_FEEDS=true

# ============ LEGAL / COMPLIANCE ============
GDPR_DATA_RETENTION_DAYS=365
ENABLE_AUDIT_TRAIL=true
ENABLE_CONSENT_TRACKING=true

# ============ AI GATEWAY ============
# Provider selection & cost controls
AI_DAILY_LIMIT_OWNER=1000
AI_DAILY_LIMIT_ADMIN=100
AI_DAILY_LIMIT_VIEWER=10
AI_MAX_COST_PER_REQUEST=0.10
AI_ENABLE_COST_CONTROL=true

# Provider health check interval (ms)
AI_HEALTH_CHECK_INTERVAL=300000

