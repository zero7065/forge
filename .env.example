# =====================================================
# PRIMORDEX — ENVIRONMENT VARIABLES
# =====================================================

# ----- SERVER CONFIG -----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# ----- AUTH -----
AUTH_JWT_SECRET=your_32_char_min_random_string_here_change_in_production
AUTH_TOKEN_EXPIRY=24h
SALT_ROUNDS=12

# ----- OWNER BOOTSTRAP -----
OWNER_EMAIL=jehu@jadai.dev
OWNER_PASSWORD=ChangeMeNow123!

# ----- DATABASE -----
DB_TYPE=sqlite
DB_PATH=./data/primordex.db

# ----- AI PROVIDERS (Primary -> Fallback) -----
# PRIMARY: Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_DEEP=llama-3.3-70b-versatile

# SECONDARY: Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# TERTIARY: Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# QUATERNARY: OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ----- VECTOR STORE -----
CHROMA_DB_PATH=./chromadb_data
EMBEDDING_MODEL=text-embedding-004

# ----- PAYMENT GATEWAYS -----
# Paystack (NGN)
PAYSTACK_SECRET_KEY=your_paystack_secret_live_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Stripe (International)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Coinbase Commerce (Crypto)
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_WEBHOOK_SECRET=your_coinbase_webhook_secret

# ----- SCHEDULER -----
BRIEFING_TIME=07:00
ALERT_INTERVAL=900000
LEGAL_SCAN_DAY=1
LEGAL_SCAN_TIME=08:00

# ----- MISC -----
MAX_UPLOAD_SIZE=52428800
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60
CONSCIOUSNESS_STATE=ACTIVE

# ----- GITHUB INTEGRATION -----
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/oauth/callback

# ----- VOICE-TO-TEXT (Whisper) -----
# Required for server-side speech transcription
# Optional: Client can use Web Speech API as fallback
OPENAI_API_KEY=your_openai_key_for_whisper